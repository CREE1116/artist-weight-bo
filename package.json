{
  "name": "artist-weight-bo",
  "version": "0.1.0",
  "description": "Preferential Bayesian optimization over fixed NovelAI artist-tag weights",
  "main": "electron/main.cjs",
  "author": "Local research prototype",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip dir",
    "build:win": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "local.artistweightbo.explorer",
    "productName": "Artist Weight BO",
    "asar": true,
    "asarUnpack": ["core/**", "web/**", "main.py"],
    "files": ["electron/**/*", "web/**/*", "core/**/*", "main.py", "requirements.txt", "config.example.json", "README.md"],
    "extraResources": [
      {"from": "data/danbooru-wiki.sqlite3", "to": "data/danbooru-wiki.sqlite3"},
      {"from": "data/DANBOORU_WIKI_LICENSE.md", "to": "data/DANBOORU_WIKI_LICENSE.md"}
    ],
    "publish": null,
    "mac": {"category": "public.app-category.graphics-design", "target": ["dir"]},
    "win": {"target": ["zip"]}
  }
}
